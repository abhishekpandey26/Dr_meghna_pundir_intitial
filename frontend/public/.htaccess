<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward sitemap.xml and robots.txt to the backend server dynamically.
  # Replace "https://your-backend-api.com" with your actual deployed Node.js backend URL.
  # If Hostinger gives a 500 Internal Error, change [P,L] to [R=301,L] to use redirects instead of proxy.
  RewriteRule ^sitemap\.xml$ https://drmeghapundir.in/sitemap.xml [P,L]
  RewriteRule ^robots\.txt$ https://drmeghapundir.in/robots.txt [P,L]

  # 2. React Router SPA configuration
  # This makes sure direct visits to /blog/slug or /admin do not return 404 errors on Hostinger
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
