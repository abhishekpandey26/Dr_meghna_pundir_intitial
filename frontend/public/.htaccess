<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward sitemap.xml to your Node.js backend which is running on the /api subfolder!
  # This uses an internal Apache rewrite, which is completely silent to the user and avoids any loop.
  RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L]

  # 2. React Router SPA configuration
  # This makes sure direct visits to /blog/slug or /admin do not return 404 errors on Hostinger
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
